    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
